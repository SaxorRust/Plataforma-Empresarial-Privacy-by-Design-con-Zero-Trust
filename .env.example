# ==============================================================================
# Plataforma Empresarial Privacy-by-Design con Zero Trust y Auditoría SIEM
# Copia este archivo a `.env` y reemplaza los valores antes de ejecutar Docker
# NUNCA subas `.env` al repositorio.
# ==============================================================================

APP_ENV=development
APP_NAME=Hospital-Privacy-ZeroTrust
APP_PORT=8000
SIEM_UI_PORT=8080
SIEM_SYSLOG_PORT=5514

# PostgreSQL (Red interna aislada)
POSTGRES_DB=hospital_zt
POSTGRES_USER=zt_app_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURA_POSTGRES

# HashiCorp Vault (Tokenización y Cifrado)
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=CAMBIAR_TOKEN_VAULT_DEV
VAULT_TRANSIT_KEY=hospital-pii-key

# Open Policy Agent (OPA)
OPA_URL=http://opa:8181/v1/data/hospital/authz/decision

# Seguridad de Aplicación (Argon2id + WebAuthn + JWT)
ARGON2_PEPPER=CAMBIAR_PEPPER_SECRETO_32_CHARS_MIN
JWT_SECRET_KEY=CAMBIAR_JWT_SECRET_64_CHARS_MIN
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# WebAuthn / FIDO2 (Passkeys) - Ajustar al dominio cloudflared en producción
WEBAUTHN_RP_ID=tralaleritosmigajeros.uk
WEBAUTHN_RP_NAME=Hospital Privacy Zero Trust BUAP
WEBAUTHN_ORIGIN=https://tralaleritosmigajeros.uk

# SIEM & Syslog RFC 5424
SIEM_HOST=siem-collector
SIEM_PORT=5514
SIEM_DB_PATH=/data/siem_events.db
SIEM_BRUTE_FORCE_THRESHOLD=5
SIEM_BRUTE_FORCE_WINDOW_SECONDS=60
SIEM_MASS_QUERY_THRESHOLD=10
SIEM_MASS_RECORDS_THRESHOLD=25
SIEM_MASS_QUERY_WINDOW_SECONDS=60
SIEM_POLICY_DENIAL_THRESHOLD=5
SIEM_POLICY_DENIAL_WINDOW_SECONDS=120
SIEM_ALERT_COOLDOWN_SECONDS=30
